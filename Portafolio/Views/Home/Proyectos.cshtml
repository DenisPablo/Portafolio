@model List<ProyectoViewModel>

<div class="row">
    @foreach (var proyecto in Model)
    {
        <div class="col-10 card  bg-dark mt-2">
            <div class="card-body d-flex justify-content-between">
                <div class="col-2 left-div">
                    <img class="img-thumbnail" src="~/Imagenes/web-design-3411373_640.jpg" />
                </div>

                <div class="col-8 right-div">
                    <h5 class="text-center">@proyecto.Titulo</h5>
                    <div class="text-justify">
                        @Html.Raw(proyecto.Descripcion)
                    </div>

                    <div>
                        <span>Tecnologias:</span>
                        @foreach (var tecnologia in proyecto.Tecnologias)
                        {
                            <span>@tecnologia</span>
                        }
                    </div>

                    <div>
                        <span>Meses @proyecto.Antiguedad</span>
                    </div>

                    <div>
                        <span>Categoria @proyecto.Categoria</span>
                    </div>

                </div>
            </div>
        </div>
    }
</div>

