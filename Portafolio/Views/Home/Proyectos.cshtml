@model List<ProyectoViewModel>


<div class="container">
    <div class="row">
        @foreach (var proyecto in Model)
        {
            <div class="col-12 col-md-3 mt-3">
                <!-- Control de tamaño en diferentes pantallas -->
                <div class="card bg-dark text-white mt-3">
                    <div class="card-title text-center mt-2">
                        <h5>@proyecto.Titulo</h5>
                    </div>

                    <div class="card-img text-center">
                        <img class="img-thumbnail mx-auto d-block"
                             src="~/Imagenes/web-design-3411373_640.jpg"
                             alt="Miniatura del proyecto" />
                    </div>

                    <div class="card-header">
                        <p><strong class="text-success">Tecnologías:</strong> @string.Join(", ", proyecto.Tecnologias.Select(t => t.Nombre))</p>
                        <p><strong class="text-success">Antigüedad:</strong> @proyecto.Antiguedad meses</p>
                        <p><strong class="text-success">Categoría:</strong> @proyecto.Categoria</p>
                    </div>

                    <div class="card-body">
                        @Html.Raw(proyecto.Descripcion)
                    </div>

                    <div class="card-footer">
                        <a class="btn btn-outline-success"
                           asp-controller="Home"
                           asp-action="Detalles"
                           asp-route-ProyectoID="@proyecto.ProyectoID">
                            Ver detalles
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>



@section Styles {
    <link rel="stylesheet" href="~/css/Proyectos.css" asp-append-version="true" />
}

