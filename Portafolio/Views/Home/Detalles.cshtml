@model ProyectoViewModel
@{
    bool isFirst = true;
    ViewData["Title"] = Model.Titulo;
}

<div class="container">
    <div class="card bg-dark p-3">
        <div class="card-body">
            <div class="text-center mb-4 card-title bg-dark">
                <h1>@Model.Titulo</h1>
            </div>

            <div class="descripcion">
                @Html.Raw(Model.Descripcion)
            </div>

            @if (Model.Imagenes != null && Model.Imagenes.Any())
            {
                <div class="descripcion position-relative">

                    <div class="galeria slide ms-auto me-auto">
                        <div id="galeriaCarousel" class="carousel" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                @foreach (var imagen in Model.Imagenes)
                                {
                                    <div class="carousel-item @(isFirst ? "active" : "")">
                                        <img src="@imagen.URL" class="d-block w-100 img-fluid" alt="Imagen">
                                    </div>
                                    isFirst = false;
                                }
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#galeriaCarousel"
                                data-bs-slide="prev">
                                <span class="carousel-control-prev-icon"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#galeriaCarousel"
                                data-bs-slide="next">
                                <span class="carousel-control-next-icon"></span>
                            </button>
                        </div>
                    </div>

                    <div class="float-end">
                        <a class="btn btn-outline-success align-self-end mt-2">
                            <i class="bi bi-file-earmark-code-fill"></i> Demo
                        </a>
                        <a class="btn btn-outline-success align-self-end mt-2" href="@Model.UrlGitHub" target="_blank">
                            <i class="bi bi-github"></i> Codigo
                        </a>
                    </div>
                </div>
            }
        </div>

        <div class="card-footer bg-dark">
            @foreach (var tecnologia in Model.Tecnologias)
            {
                <img src="@tecnologia.URLIcon" alt="@(tecnologia.Nombre) Logo" width="50">
            }
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/ProyectoDetalles.css" asp-append-version="true" />
}
