@using Microsoft.AspNetCore.Identity
@inject SignInManager<Usuario> SignInManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link text-white"><b class="text-success">Hola, @User.Identity.Name.Split('@')[0]</b></span>
        </li>    
        <li class="nav-item">
            <form asp-controller="Usuario" asp-action="CerrarSesion">
                <button class="btn btn-secondary" type="submit"><i class="bi bi-emoji-wink-fill fs-5"></i></button>
            </form>
        </li>
    } else
    {
        <li class="nav-item">
            <a class="nav-link text-white" asp-action="Registro" asp-controller="Usuario">Registrarse</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white" asp-action="IniciarSesion" asp-controller="Usuario">Iniciar sesión</a>
        </li>
    }
</ul>