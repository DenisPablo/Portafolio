@using Microsoft.AspNetCore.Identity
@inject SignInManager<Usuario> SignInManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <form asp-controller="Usuario" asp-action="CerrarSesion">
                <button class="btn-custom btn-danger btn btn-outline-danger" type="submit"><b class="text-success">Hola, @User.Identity.Name.Split('@')[0]</b></button>
            </form>
        </li>
    }
</ul>