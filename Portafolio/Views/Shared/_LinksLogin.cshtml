@using Microsoft.AspNetCore.Identity
@inject SignInManager<Usuario> SignInManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link text-white">Hola, @User.Identity.Name</span>
        </li>    
        <li class="nav-item">
            <form class="form-inline" asp-action="CerrarSesion" asp-controller="Usuario">
                <button type="submit" class="btn btn-link nav-link text-white">Cerrar sesión</button>
            </form>
        </li>
    } else
    {
        <li class="nav-item">
            <a class="nav-link text-white" asp-action="Registro" asp-controller="Usuario">Registrarse</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white" asp-action="IniciarSesion" asp-controller="Usuario">Iniciar sesión</a>
        </li>
    }
</ul>