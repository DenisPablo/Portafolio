@model IEnumerable<Tecnologia>

@{
    ViewData["Title"] = "Papelera Tecnologia";
}

<h1 class="text-center">Papelera de Tecnologias</h1>
<hr>

<div class="tabla mt-3">
    <table class="table table-dark table-striped table-hover">
        <thead>
            <tr>
                <th class="text-center">Nombre</th>
                <th class="text-center">Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tecnologia in Model)
            {
                <tr>
                    <td class="text-center">@tecnologia.Nombre</td>
                    <td class="text-center"><i class="bi bi-check-circle-fill"></i></td>
                    <td class="text-center">
                        <a asp-action="ConfirmarRestaurar" asp-controller="Tecnologia" asp-route-TecnologiaID="@tecnologia.TecnologiaID" class="btn btn-success">Restaurar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>