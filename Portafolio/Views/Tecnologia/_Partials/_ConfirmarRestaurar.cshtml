@model Tecnologia
@{
    ViewData["Title"] = "Confirmar Restauracion";
}


<h1>Confirmar Restaurar</h1>
<p>¿Estas seguro de querer restaurar la tecnologia <strong>@Model.Nombre</strong>?</p>

<form asp-action="Restaurar" method="post">
    <input type="hidden" asp-for="TecnologiaID" />
    <input type="hidden" asp-for="Nombre" />
    <button type="submit" class="btn btn-danger">Restaurar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>