@model Proyecto
@{
    var tecnologiasUsadas = ViewBag.TecnologiasUsadas as IEnumerable<Tecnologia>;
}


<!-- Esto tiene una validacion de CRSF automatica -->
<form asp-controller="Proyecto" asp-action="@(Model.ProyectoID == 0 ? "Crear" : "Editar")" method="post"
    enctype="multipart/form-data">
    <!--
        asp-for: Permite vincular los campos del modelos con los campos del formulario

        asp-validation-for permite mostrar el mensaje de error vinculado al campo:
        NOTA: Para que funcionen correctamente deben incluirse los script de validacion en Frot,
        en este momento se encuetran agregados en _Layout
    -->
    <input type="hidden" asp-for="ProyectoID" />
    <div class="mb-3">
        <input type="text" asp-for="Titulo" class="form-control" placeholder="Titulo" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <select asp-for="CategoriaID" asp-items="@(ViewBag.Categorias)" class="form-control">
            <option value="">Seleccione una categoria</option>
        </select>
    </div>

    <div class="mb-3">
        <textarea id="Descripcion" name="Descripcion" class="form-control"
            placeholder="Descripcion">@Model.Descripcion</textarea>
    </div>

    <div class="mb-3">
        <label for="imagenes" class="form-label">Imagenes del Proyecto</label>
        <input type="file" id="imagenes" name="imagenes" class="form-control" multiple />
    </div>


    @if (Model.ProyectoID != 0)
    {
        <div class="row g-3">
            @foreach (var imagen in ViewBag.Imagenes)
            {
                <div class="col-md-4 position-relative border p-2 rounded text-center">
                    <input type="checkbox" name="publicIDs" value="@imagen.PublicID"
                        class="position-absolute top-0 start-0 m-2">
                    <img src="@imagen.URL" alt="Imagen" class="img-fluid rounded">
                </div>
            }
        </div>
    }

    <div class="mt-3">
        <input type="text" asp-for="UrlGitHub" class="form-control" placeholder="Url del repositorio" />
        <span asp-validation-for="UrlGitHub" class="text-danger"></span>
    </div>

    <div class="mt-3">
        <input type="text" asp-for="UrlDesplegado" class="form-control" placeholder="Url del Proyecto" />
        <span asp-validation-for="UrlDesplegado" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <div class="checkbox-group mt-3">
            @foreach (var tecnologia in ViewBag.Tecnologias)
            {
                <div class="form-check col-2">
                    <input class="custom-checkbox" type="checkbox" name="TecnologiasSeleccionadas"
                        value="@tecnologia.TecnologiaID" id="@tecnologia.TecnologiaID" @(tecnologiasUsadas.Any(t =>
                        t.TecnologiaID == tecnologia.TecnologiaID) ? "checked" : "") />
                <label class="custom-label" for="@tecnologia.TecnologiaID">@tecnologia.Nombre</label>
            </div>
                        }
        </div>
    </div>

    <div id="guardar" class="m-2 ms-auto">
        <button onclick="confirmar()" type="button" class="btn btn-primary">
            @(Model.ProyectoID == 0 ? "Crear" : "Guardar Cambios")
        </button>
        <a asp-action="Index" asp-controller="Proyecto" class="btn btn-secondary">Cancelar</a>
    </div>

    <div id="confirmar" class="mb-3 confirmar alert-danger text-center">
        <p>¿Esta seguro que desea realizar esta accion?</p>
        <button type="submit" class="btn btn-primary">Confirmar</button>
        <a asp-action="Index" asp-controller="Categoria" class="btn btn-secondary">Cancelar</a>
    </div>
</form>