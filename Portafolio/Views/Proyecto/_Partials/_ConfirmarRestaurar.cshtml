@model Proyecto
@{
    ViewData["Title"] = "Confirmar Restauracion";
}


<h1>Confirmar Restaurar</h1>
<p>¿Estas seguro de querer restaurar el proyecto <strong>@Model.Titulo</strong>?</p>

<form asp-action="Restaurar" method="post">
    <input type="hidden" asp-for="ProyectoID" />
    <input type="hidden" asp-for="Titulo" />
    <button type="submit" class="btn btn-danger">Restaurar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>