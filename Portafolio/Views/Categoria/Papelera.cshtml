@model IEnumerable<Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<h1 class="text-center">Papelera de Categorias</h1>
<hr>

<div class="tabla mt-3">
    <table class="table table-dark table-striped table-hover">
        <thead>
            <tr>
                <th class="text-center">Nombre</th>
                <th class="text-center">Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Categoria categoria in Model)
            {
                <tr>
                    <td class="text-center">@categoria.Nombre</td>
                    <td class="text-center"><i class="bi bi-check-circle-fill"></i></td>
                    <td class="text-center">
                        <a asp-action="ConfirmarRestaurar" asp-controller="Categoria" asp-route-CategoriaID="@categoria.CategoriaID" class="btn btn-success">Restaurar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>