@model IniciarSesionViewModel

@{
    ViewBag.Title = "Iniciar Sesión";
}

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card bg-dark text-white p-4 w-75 h-50">
        <h1 class="card-title text-center">Iniciar Sesión</h1>
        <div class="card-body">
            <form asp-action="IniciarSesion" asp-controller="Usuario">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <input asp-for="Email" class="form-control" placeholder="Email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <input asp-for="Password" type="password" class="form-control" placeholder="Contraseña" />
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Recordar" class="form-check-input" input />
                    <label asp-for="Recordar" class="form-check-label"></label>
                </div>

                <div class="mb-3 text-center">
                    <button class="btn btn-primary">Iniciar Sesion</button>
                    <a class="btn btn-success" asp-controller="Usuario" asp-action="Registro">Registrarse</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}